# Signaling & Yjs server
SIGNALING_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SIGNALING_URL=http://localhost:3001

# Room access control, JWT & SQLite persistence
# Set a random 32+ character secret in production!
# JWT_SECRET=replace-with-at-least-32-random-characters
# DATABASE_PATH=./data/interview-room.db
ROOM_TTL_MINUTES=120
REPORT_RETENTION_HOURS=24

# Optional TURN server for restrictive NATs/firewalls
# NEXT_PUBLIC_TURN_URL=turn:your-server-ip:3478
# NEXT_PUBLIC_TURN_USERNAME=interview
# NEXT_PUBLIC_TURN_CREDENTIAL=change-this-turn-password

# Judge0 sandbox server (server-side only; never exposed to the browser)
# Example: https://your-ip/judge0
JUDGE0_URL=http://localhost:2358
# Set to "true" if your Judge0 HTTPS endpoint uses a self-signed certificate
JUDGE0_ALLOW_SELF_SIGNED=false
# Optional auth token if Judge0 is configured with X-Auth-Token
# JUDGE0_AUTH_TOKEN=
